FROM eclipse-temurin:21-jdk AS builder
ARG AERON_VERSION=1.50.4

RUN wget -q -O /aeron-all.jar \
      "https://repo1.maven.org/maven2/io/aeron/aeron-all/${AERON_VERSION}/aeron-all-${AERON_VERSION}.jar"

COPY examples/trading/java /src
RUN mkdir -p /out && javac -cp /aeron-all.jar -d /out \
    /src/TradingOrderBook.java \
    /src/TradingOrderBookTest.java \
    /src/TradingSample.java \
    /src/BtcUsdtClusterService.java \
    /src/JavaTradingClusterNode.java \
    /src/JavaTradingClusterClient.java

FROM eclipse-temurin:21-jre
COPY --from=builder /aeron-all.jar /aeron-all.jar
COPY --from=builder /out /trading
ENTRYPOINT ["java"]
